# Frontend only. Copy to .env; restart Nuxt after edits.
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# Runtime overrides for a deployed Nuxt server:
# NUXT_PUBLIC_API_BASE=https://api.watdenktnl.nl/api
DEMO_ADS=1
ADS_ENABLED=0
# Live providers remain disabled until a certified CMP adapter is ready.
# Payment, RevenueCat, DB and LLM secrets belong in ../wvnl-api/.env only.

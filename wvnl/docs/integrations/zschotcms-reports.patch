diff --git a/frontend/components/panels/WdnlReportPanel.vue b/frontend/components/panels/WdnlReportPanel.vue
new file mode 100644
--- /dev/null
+++ b/frontend/components/panels/WdnlReportPanel.vue
@@ -0,0 +1,80 @@
+<script setup lang="ts">
+import type { Integration } from '~/types/Cms';
+type Settings = { provider: string; model: string; ai_enabled: boolean; max_iterations: number; max_output_tokens: number; max_input_bytes: number; max_cost_eur: number; input_usd_per_million: number; output_usd_per_million: number; usd_to_eur: number; pricing_multiplier: number; pricing_verified_on: string; minimum_votes: number; renew_after_votes: number };
+type Config = { settings: Settings; revision: number; models: Record<string, string[]>; price_presets: Record<string,{ input:number; output:number }>; credentials: Record<string, boolean>; sales_enabled: boolean; price_cents: number };
+type Stats = { completed_reports: number; attempts: number; unknown_usage_attempts: number; input_tokens: number; output_tokens: number; total_eur: number; average_eur: number | null };
+const props = defineProps<{ integration: Integration }>();
+const api = useIntegrationAction<unknown>(() => props.integration);
+const config = ref<Config | null>(null);
+const draft = ref<Settings | null>(null);
+const stats = ref<Stats | null>(null);
+const estimate = ref<{ estimated_eur: number; within_budget: boolean } | null>(null);
+const inputTokens = ref(10000);
+const outputTokens = ref(1500);
+const flash = ref('');
+const euro = (v: number) => new Intl.NumberFormat('nl-NL', { style: 'currency', currency: 'EUR', minimumFractionDigits: 4, maximumFractionDigits: 4 }).format(v);
+const fields = [
+  { key: 'max_iterations', label: 'Maximaal aantal pogingen', min: 1, max: 3, step: 1 },
+  { key: 'max_cost_eur', label: 'Maximaal AI-budget per rapport (€)', min: .001, max: .20, step: .001 },
+  { key: 'max_output_tokens', label: 'Outputlimiet per poging (inclusief redeneren)', min: 300, max: 4000, step: 100 },
+  { key: 'max_input_bytes', label: 'Maximale invoergrootte (bytes)', min: 4000, max: 64000, step: 1000 },
+  { key: 'input_usd_per_million', label: 'Inputprijs (USD per miljoen tokens)', min: .001, max: 100, step: .001 },
+  { key: 'output_usd_per_million', label: 'Outputprijs (USD per miljoen tokens)', min: .001, max: 500, step: .001 },
+  { key: 'usd_to_eur', label: 'Rekenkoers: 1 USD in EUR (handmatig)', min: .1, max: 3, step: .01 },
+  { key: 'pricing_multiplier', label: 'Veiligheidsfactor voor budgetreservering', min: 1, max: 3, step: .05 },
+  { key: 'minimum_votes', label: 'Minimaal aantal stemmen voor een rapport', min: 10, max: 200, step: 1 },
+  { key: 'renew_after_votes', label: 'Nieuwe stemmen vóór een updatevoorstel', min: 10, max: 200, step: 1 },
+] as const;
+function changeProvider() {
+  if (!draft.value || !config.value) return;
+  draft.value.model = config.value.models[draft.value.provider]?.[0] || '';
+  changeModel();
+}
+function changeModel() {
+  if (!draft.value) return;
+  const rates = config.value?.price_presets[draft.value.model];
+  if (rates) [draft.value.input_usd_per_million, draft.value.output_usd_per_million] = [rates.input, rates.output];
+  estimate.value = null;
+}
+async function load() {
+  const result = await api.run('report_settings') as Config | null;
+  if (!result) return;
+  config.value = result;
+  draft.value = { ...result.settings };
+  stats.value = await api.run('report_stats') as Stats | null;
+}
+async function save() {
+  if (!draft.value || !config.value) return;
+  const result = await api.run('save_report_settings', { payload: { ...draft.value, revision: config.value.revision } }) as Config | null;
+  if (result) { config.value = result; draft.value = { ...result.settings }; estimate.value = null; flash.value = 'Opgeslagen. Nieuwe aankopen gebruiken deze instellingen; eerdere rapporten blijven hetzelfde.'; }
+}
+async function calculate() {
+  estimate.value = await api.run('estimate_report_cost', { payload: { input_tokens: Number(inputTokens.value), output_tokens: Number(outputTokens.value) } }) as typeof estimate.value;
+}
+onMounted(load);
+</script>
+<template>
+  <section class="space-y-5">
+    <div class="card space-y-2 p-5"><h3 class="font-semibold">Eén aankoop, één vast rapport — € 1,99</h3><p class="text-sm text-slate-600">Opnieuw bekijken en downloaden blijft beschikbaar. Een nieuw rapport is een nieuwe aankoop. De applicatie maakt tellingen, grafieken en A4-opmaak; AI schrijft alleen korte toelichtingen.</p><p class="text-xs text-slate-500">Een updatevoorstel gebruikt het aantoonbare aantal nieuwe antwoorden. Er wordt geen politieke verschuiving verzonnen.</p></div>
+    <ErrorAlert :message="api.error.value" />
+    <p v-if="flash" role="status" class="rounded-lg bg-emerald-50 p-3 text-sm text-emerald-800">{{ flash }}</p>
+    <p v-if="api.loading.value" role="status">Laden…</p>
+    <template v-if="draft && config">
+      <div class="grid gap-3 sm:grid-cols-3"><div class="card p-4"><p class="text-xs text-slate-500">Gegenereerde rapporten</p><strong class="text-2xl">{{ stats?.completed_reports ?? 0 }}</strong></div><div class="card p-4"><p class="text-xs text-slate-500">Gemiddelde AI-kosten per rapport</p><strong class="text-xl">{{ stats?.average_eur == null ? 'Nog geen metingen' : euro(stats.average_eur) }}</strong></div><div class="card p-4"><p class="text-xs text-slate-500">Berekende AI-kosten totaal</p><strong class="text-xl">{{ euro(stats?.total_eur ?? 0) }}</strong></div></div>
+      <p class="text-xs text-slate-500">Gebaseerd op ontvangen tokengebruik, ingestelde tarieven en rekenkoers; geen factuurbedrag of live valutakoers. Onbekend gebruik reserveert conservatief het maximale aanvraagbedrag. {{ stats?.unknown_usage_attempts ?? 0 }} pogingen met onbekend gebruik. Geen gebruikersgegevens of steminhoud zichtbaar in het CMS.</p>
+      <form class="card space-y-5 p-5" @submit.prevent="save">
+        <h3 class="font-semibold">Provider, model en kostenbegrenzing</h3>
+        <label class="flex items-start gap-2 text-sm"><input v-model="draft.ai_enabled" type="checkbox" class="mt-1" /><span>Korte AI-toelichting gebruiken na afzonderlijke toestemming. Zonder AI of bij een fout blijft de codeversie beschikbaar.</span></label>
+        <div class="grid gap-4 sm:grid-cols-2"><label><span class="label">LLM-provider</span><select v-model="draft.provider" class="input" @change="changeProvider"><option value="openai">OpenAI</option><option value="deepseek">DeepSeek</option></select></label><label><span class="label">Model</span><select v-model="draft.model" class="input" @change="changeModel"><option v-for="model in config.models[draft.provider]" :key="model">{{ model }}</option></select></label></div>
+        <p class="text-xs" :class="config.credentials[draft.provider] ? 'text-emerald-700' : 'text-amber-700'">{{ config.credentials[draft.provider] ? 'API-sleutel aanwezig in de WDNL-backend.' : 'API-sleutel ontbreekt. Voeg deze toe aan de beveiligde backendconfiguratie; de sleutel komt niet in het CMS of de app.' }}</p>
+        <p class="text-xs text-slate-500">Iteraties zijn maximaal toegestane herstelpogingen bij ongeldige tekst. Er wordt gestopt zodra één geldige tekst is ontvangen. Een time-out wordt niet blind opnieuw geprobeerd. €0,20 is een plafond, geen bedrag dat moet worden opgebruikt.</p>
+        <div class="grid gap-4 sm:grid-cols-2"><label v-for="field in fields" :key="field.key"><span class="label">{{ field.label }}</span><input v-model.number="draft[field.key]" type="number" required :min="field.min" :max="field.max" :step="field.step" class="input" /></label><label><span class="label">Tarieven gecontroleerd op</span><input v-model="draft.pricing_verified_on" type="date" required class="input" :max="new Date().toLocaleDateString('sv-SE')" /></label></div>
+        <p class="text-xs text-slate-500">Modelpresets: officiële tarieven gecontroleerd op 8 november 2026; DeepSeek gebruikt het hogere piektarief. Verifieer prijzen bij een modelwijziging. De budgetcontrole gebruikt deze tarieven; afwijkende providerfacturatie kan daarmee niet worden gegarandeerd.</p>
+        <button class="btn-primary" :disabled="api.loading.value">Rapportinstellingen opslaan</button>
+      </form>
+      <form class="card space-y-4 p-5" @submit.prevent="calculate"><h3 class="font-semibold">Kostenvoorbeeld zonder LLM-aanroep</h3><p class="text-xs text-slate-500">Gebruikt de opgeslagen instellingen, alle toegestane pogingen en de veiligheidsfactor. Grafieken en PDF-opmaak gebruiken geen LLM-tokens.</p><div class="grid gap-4 sm:grid-cols-2"><label><span class="label">Inputtokens</span><input v-model.number="inputTokens" type="number" min="0" max="100000" class="input" required /></label><label><span class="label">Outputtokens per poging</span><input v-model.number="outputTokens" type="number" min="0" max="4000" class="input" required /></label></div><button class="btn-secondary" :disabled="api.loading.value">Bereken kosten</button><p v-if="estimate" role="status" class="text-sm" :class="estimate.within_budget ? 'text-emerald-700' : 'text-red-700'">{{ euro(estimate.estimated_eur) }} · {{ estimate.within_budget ? 'Binnen het budget' : 'Boven het budget' }}</p></form>
+      <p class="rounded-lg bg-amber-50 p-4 text-sm text-amber-900">{{ config.sales_enabled ? 'Verkoop is aangezet in de backend; een bereikbare webhook en queueworker blijven vereist.' : 'Verkoop staat nog uit. Stripe-keys, webhook, worker en privacycontrole moeten vóór activering worden ingesteld. Native in-app aankopen wachten op de storeconfiguratie.' }}</p>
+    </template>
+    <button v-if="!api.loading.value" class="btn-secondary" @click="load">Instellingen en metingen vernieuwen</button>
+  </section>
+</template>
